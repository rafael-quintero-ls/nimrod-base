# gitlint configuration for vuexy-template.
# Run manually:      uvx --from gitlint-core gitlint
# Lint a range:       uvx --from gitlint-core gitlint --commits main..HEAD
# Install as a hook:  uvx --from gitlint-core gitlint install-hook
# See .omp/skills/write-commits/SKILL.md for the full workflow this enforces.

[general]
# Conventional Commits (https://www.conventionalcommits.org/) on the title.
contrib=contrib-title-conventional-commits

# Bodies here routinely include long backtick-quoted paths, URLs (OpenSpec
# change paths, PR links) that cannot be wrapped without breaking
# copy-paste. Body wrapping is a style preference, not a correctness
# signal, so this project does not enforce it.
ignore=body-max-line-length

[contrib-title-conventional-commits]
types=feat,fix,docs,style,refactor,perf,test,build,ci,chore,revert

[title-max-length]
line-length=72

[title-min-length]
min-length=10
